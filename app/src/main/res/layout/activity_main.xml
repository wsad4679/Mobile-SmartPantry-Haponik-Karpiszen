<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:orientation="vertical"
    android:padding="10dp"
    android:focusable="false"
    android:clickable="false"
    >
            <EditText
                android:id="@+id/productNameFilterEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="7dp"
                android:hint="Wyszukaj nazwę towaru" />

            <Spinner
                android:id="@+id/categoryFilterSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />
            <!--    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:gravity="center"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Podaj ilość produktu: "
            android:layout_margin="10dp"
            />

        <NumberPicker
            android:id="@+id/quantityNumberPicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            />
    </LinearLayout>

    <EditText
        android:id="@+id/imageRefEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Link lub referencja obrazu"
        />

    <Button
        android:id="@+id/addProductButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dodaj towar"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        />  |     Kod przygotowany do dodawania produktu do listy     | -->

            <ListView
                android:id="@+id/productListView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:dividerHeight="3dp"
                android:choiceMode="none"/>

            <!--<LinearLayout
                style="?android:attr/buttonBarStyle"
